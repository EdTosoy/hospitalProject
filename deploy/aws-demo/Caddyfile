{
	# Local-only admin endpoint; never published by Compose or security groups.
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2
	}
}

(demo_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=86400"
	}
	# Avoid collecting clinical paths/query strings or session headers in access logs.
	log {
		output discard
	}
}

abox.edtosoy.com {
	import demo_headers
	reverse_proxy frontend:3000
}

api.abox.edtosoy.com {
	import demo_headers
	@swagger path /api /api/*
	respond @swagger 404
	request_body {
		max_size 1MB
	}
	reverse_proxy backend:8080
}
