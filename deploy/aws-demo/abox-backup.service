[Unit]
Description=Encrypted synthetic abox database backup to private S3
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/abox/current/backup.py
MemoryMax=192M
CPUQuota=25%
Nice=10
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

