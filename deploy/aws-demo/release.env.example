# Public configuration only. No passwords, AWS keys, tokens, or DATABASE_URL.
# Replace SHA and app digests with outputs of the approved manual ARM64 build.
RELEASE_SHA=REPLACE_WITH_40_CHARACTER_GIT_SHA
BACKEND_IMAGE=ghcr.io/edtosoy/abox-backend:sha-REPLACE_SHA@sha256:REPLACE_DIGEST
FRONTEND_IMAGE=ghcr.io/edtosoy/abox-frontend:sha-REPLACE_SHA@sha256:REPLACE_DIGEST
POSTGRES_IMAGE=postgres:17-alpine@sha256:eee6c6e1b0894fa4fe0075eb054af9fd1cf39a35321c2d4110626cfe506411fb
CADDY_IMAGE=caddy:2-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
EXPECTED_ACCOUNT_ID=REPLACE_WITH_AUTHORIZED_ACCOUNT
BACKUP_BUCKET=REPLACE_WITH_TERRAFORM_BACKUP_BUCKET_OUTPUT
DATABASE_NAME=abox_demo
ABOX_SECRETS_DIR=/etc/abox/secrets
