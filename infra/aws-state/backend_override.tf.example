# Activate as backend_override.tf ONLY in the encrypted bootstrap working copy,
# after bucket verification and explicit authorization to migrate bootstrap state.
terraform {
  backend "s3" {
    region              = "ap-southeast-2"
    profile             = "abox-747240980964"
    allowed_account_ids = ["747240980964"]
    key                 = "abox/bootstrap/terraform.tfstate"
    encrypt             = true
    use_lockfile        = true
  }
}
